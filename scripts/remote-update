#!/usr/bin/env sh
set -eu

REPO_FILE="$HOME/.config/remote-setup/repo-dir"
REPO_DIR="${REMOTE_SETUP_DIR:-}"
PROFILE_FILE="$HOME/.config/remote-setup/profile"
PROFILE="minimal"

if [ -z "$REPO_DIR" ] && [ -f "$REPO_FILE" ]; then
  REPO_DIR=$(cat "$REPO_FILE")
fi

if [ -z "$REPO_DIR" ]; then
  REPO_DIR="$HOME/.remote-setup"
fi

if [ -f "$PROFILE_FILE" ]; then
  PROFILE=$(cat "$PROFILE_FILE")
fi

if [ ! -d "$REPO_DIR" ]; then
  printf '%s\n' "remote-update: repo not found: $REPO_DIR" >&2
  exit 1
fi

cd "$REPO_DIR"

if [ -d .git ] && git remote >/dev/null 2>&1 && [ -n "$(git remote)" ]; then
  git pull --ff-only
fi

exec "$REPO_DIR/install.sh" "$PROFILE"
