#!/usr/bin/env sh
set -eu

FZF_DIR="${FZF_DIR:-$HOME/.fzf}"

if command -v fzf >/dev/null 2>&1; then
  printf 'fzf already available: %s\n' "$(command -v fzf)"
  exit 0
fi

if ! command -v git >/dev/null 2>&1; then
  printf '%s\n' 'remote-install-fzf: git is required to install fzf' >&2
  exit 1
fi

if [ ! -d "$FZF_DIR" ]; then
  git clone --depth 1 https://github.com/junegunn/fzf.git "$FZF_DIR"
fi

"$FZF_DIR/install" --bin --key-bindings --completion --no-update-rc

printf '%s\n' 'fzf installed. Run: exec zsh'
